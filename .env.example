# Bit CLI 配置示例
# 用法：
# 1. 复制本文件为 .env
# 2. 按需填写下面的配置项
# 3. 未填写的项会回退到代码默认值

# ========== GLM 配置 ==========
# API Key（必填其一：GLM_API_KEY、DEEPSEEK_API_KEY、STEP_API_KEY、KIMI_API_KEY、FREELLMAPI_API_KEY、XFYUN_MAAS_API_KEY 或 AGNES_API_KEY）
GLM_API_KEY=your_api_key_here
# 模型名称（可选，默认 glm-5.1）
# 可选值：glm-5.1, glm-5v-turbo, glm-5.0, glm-4-flash 等
# glm-5v-turbo 支持图片输入，可配合 Ctrl+V / @image: 使用
# GLM_MODEL=glm-5.1

# ========== DeepSeek 配置 ==========
# API Key（/model deepseek 切换后使用）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 模型名称（可选，默认 deepseek-v4-flash）
# 可选值：deepseek-v4-flash, deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# ========== 阶跃星辰 StepFun 配置 ==========
# API Key（/model step 切换后使用）
# STEP_API_KEY=your_step_api_key_here
# 模型名称（可选，默认 step-3.5-flash）
# 可选值：step-3.5-flash, step-3.5-flash-2603, step-router-v1, step-1-256k 等
# STEP_MODEL=step-3.5-flash
# Base URL（可选，默认 https://api.stepfun.com/v1）
# 如果使用 Step Plan 专用通道，可设置为 https://api.stepfun.com/step_plan/v1
# STEP_BASE_URL=https://api.stepfun.com/v1

# ========== Kimi / Moonshot 配置 ==========
# API Key（/model kimi 切换后使用；兼容官方 MOONSHOT_API_KEY）
# KIMI_API_KEY=your_kimi_api_key_here
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# 模型名称（可选，默认 kimi-k2.6；兼容 MOONSHOT_MODEL）
# KIMI_MODEL=kimi-k2.6
# Base URL（可选，默认 https://api.moonshot.ai/v1；兼容 MOONSHOT_BASE_URL）
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# ========== FreeLLMAPI 本地网关配置 ==========
# API Key（/model freellmapi 切换后使用；可从 FreeLLMAPI /keys 顶部 unified API key 复制）
# FREELLMAPI_API_KEY=your_freellmapi_unified_key_here
# 模型名称（可选，默认 auto；也可填 /v1/models 返回的具体 model id）
# FREELLMAPI_MODEL=auto
# Base URL（可选，默认 http://localhost:5173/v1）
# FREELLMAPI_BASE_URL=http://localhost:5173/v1

# ========== Agnes AI 配置 ==========
# API Key（/model agnes 切换后使用；从 Agnes AI Platform 创建）
# AGNES_API_KEY=your_agnes_api_key_here
# 模型名称（可选，默认 agnes-2.0-flash）
# AGNES_MODEL=agnes-2.0-flash
# Base URL（可选，默认 https://apihub.agnes-ai.com/v1）
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ========== 讯飞星辰 MaaS 配置 ==========
# XFYUN_MAAS_API_KEY=your_xfyun_maas_api_key_here
# XFYUN_MAAS_MODEL=Qwen3.6-35B-A3B
# XFYUN_MAAS_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# XFYUN_MAAS_LORA_ID=your_lora_id_here

# Embedding 配置（用于 /index、/search、Agent 的代码检索）
# 支持 provider：ollama / openai / zhipu / glm
# 不配置时默认使用 ollama + nomic-embed-text:latest + http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434

# 如果使用需要鉴权的远程 Embedding 服务，再打开这一项
# EMBEDDING_API_KEY=your_api_key_here

# ========== Web 搜索配置 ==========
# 选择搜索 provider（zhipu | serpapi | searxng），不配置时按 Key/URL 自动判断：
# 1. 有 GLM_API_KEY -> zhipu（默认推荐：与 GLM 推理共用 Key，零额外配置，国内首选）
# 2. 有 SERPAPI_KEY -> serpapi（国际通用，付费即开即用）
# 3. 有 SEARXNG_URL -> searxng（开源自托管，免费，需本地跑 docker 实例）
# SEARCH_PROVIDER=zhipu

# 智谱 Web Search 引擎（SEARCH_PROVIDER=zhipu 时启用）
# 可选：search_std（默认）、search_pro、search_pro_sogou、search_pro_quark
# ZHIPU_SEARCH_ENGINE=search_std

# SerpAPI Key（SEARCH_PROVIDER=serpapi 时启用）
# SERPAPI_KEY=your_serpapi_key_here

# SearXNG 实例地址（SEARCH_PROVIDER=searxng 时启用）
# SEARXNG_URL=http://localhost:8888

# ========== Web 抓取配置 ==========
# web_fetch 工具默认走 HTTP + Jsoup 提取正文。
# 对 SPA / 强防爬站点会回退到浏览器 MCP 链路。

# ========== MCP 配置 ==========
# MCP server 配置文件位置：
# 1. 用户级 ~/.bitcli/mcp.json
# 2. 项目级 .bitcli/mcp.json（按 server 名覆盖用户级）
# 支持 ${PROJECT_DIR}、${HOME} 和环境变量 ${VAR} 展开。
# REMOTE_TOKEN=your_remote_mcp_token_here

# ========== 渲染器形态 ==========
# BITCLI_RENDERER=inline    # 默认 inline 流式 TUI
# BITCLI_RENDERER=lanterna  # 切换到 Lanterna 三栏全屏 TUI
# BITCLI_RENDERER=plain     # 纯 println 兜底
# BITCLI_NO_STATUSBAR=true  # inline 模式下禁用底部状态栏

# 兼容旧设置：BITCLI_TUI=true 自动映射为 BITCLI_RENDERER=lanterna
# BITCLI_TUI=true

# ========== LSP 诊断注入 ==========
# BITCLI_LSP_ENABLED=true
# BITCLI_LSP_MAX_DIAGNOSTICS=20

# ========== Side-Git 快照与回滚 ==========
# BITCLI_SNAPSHOT_ENABLED=true
# BITCLI_SNAPSHOT_MAX=50
# BITCLI_SNAPSHOT_EXCLUDES=.git,.bitcli/snapshots,target,node_modules,dist,.idea,*.class,*.jar
# BITCLI_SNAPSHOT_DIR=/Users/yourname/.bitcli/snapshots

# ========== 后台任务 + Runtime API ==========
# BITCLI_TASK_DIR=/Users/yourname/.bitcli/tasks
# BITCLI_TASK_WORKERS=2
# BITCLI_RUNTIME_API_KEY=your_local_api_key
# BITCLI_RUNTIME_DIR=/Users/yourname/.bitcli/runtime

# ========== Chrome DevTools MCP ==========
# ~/.bitcli/mcp.json 不存在时，Bit CLI 会自动创建默认 chrome-devtools 配置。
# 如果首次启动 npx 拉包或 Chrome 冷启较慢，可调长初始化超时：
# BITCLI_MCP_INITIALIZE_TIMEOUT_SECONDS=60
# 启动期等待时间：
# BITCLI_MCP_STARTUP_WAIT_SECONDS=15

# ========== 历史记录 ==========
# BITCLI_HISTORY_FILE=/Users/yourname/.bitcli/input.history
# BITCLI_HISTORY_SIZE=2000
# BITCLI_HISTORY_FILE_SIZE=10000

# ========== LLM HTTP 超时（可选）==========
# 如遇频繁 timeout，再通过 -Dbitcli.llm.read.timeout.seconds=600 调大

# 日志配置（支持自动滚动、压缩和清理）
BITCLI_LOG_LEVEL=INFO
BITCLI_LOG_DIR=/Users/yourname/.bitcli/logs
BITCLI_LOG_MAX_HISTORY=7
BITCLI_LOG_MAX_FILE_SIZE=10MB
BITCLI_LOG_TOTAL_SIZE_CAP=100MB

# ========== 操作审计配置 ==========
# BITCLI_AUDIT_DIR=/Users/yourname/.bitcli/audit

# ========== Memory / Runtime / Wechat 目录配置 ==========
# BITCLI_MEMORY_DIR=/Users/yourname/.bitcli/memory
# BITCLI_WECHAT_DIR=/Users/yourname/.bitcli/wechat

# ========== 终端与显示 ==========
# NO_COLOR=1
# TERM=xterm-256color
# COLORTERM=truecolor
# COLUMNS=120
# NO_TUI=true
